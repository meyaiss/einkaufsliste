{
  "name": "Einkaufsliste",
  "short_name": "Einkaufsliste",
  "description": "Einkaufsliste zum Abhaken – mit Barcode-Scanner, Spracheingabe und Teilen per WhatsApp.",
  "lang": "de",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#EEF2EE",
  "theme_color": "#1E5A44",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "text/plain",
            ".txt",
            "application/json",
            ".json"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "text/plain": [
          ".txt"
        ],
        "application/json": [
          ".json"
        ]
      }
    }
  ],
  "shortcuts": [
    {
      "name": "Schnell eintragen",
      "short_name": "Eintragen",
      "description": "Liste öffnen und direkt etwas eintragen",
      "url": "./?add=1",
      "icons": [
        {
          "src": "icons/shortcut-add.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Einkaufsmodus",
      "short_name": "Im Laden",
      "description": "Liste groß und ohne Ablenkung zum Abhaken",
      "url": "./?shop=1",
      "icons": [
        {
          "src": "icons/shortcut-shop.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}