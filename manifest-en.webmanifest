{
  "name": "Shopping List",
  "short_name": "Shopping List",
  "description": "Shopping list to tick off – sorted by aisle, with barcode scanner, voice input and shared lists.",
  "lang": "en",
  "id": "./einkaufsliste/",
  "start_url": "./einkaufsliste/",
  "scope": "./einkaufsliste/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#EEF2EE",
  "theme_color": "#1E5A44",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "text/plain",
            ".txt",
            "application/json",
            ".json"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "text/plain": [
          ".txt"
        ],
        "application/json": [
          ".json"
        ]
      }
    }
  ],
  "shortcuts": [
    {
      "name": "Quick add",
      "short_name": "Add",
      "description": "Open the list and add something right away",
      "url": "./?add=1",
      "icons": [
        {
          "src": "icons/shortcut-add.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Shopping mode",
      "short_name": "In store",
      "description": "Big list without distractions for ticking off",
      "url": "./?shop=1",
      "icons": [
        {
          "src": "icons/shortcut-shop.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
